{
  // Update interval of the remote config in hours.
  "update-interval": 10,
  // Messages shown to the user.
  "messages": {
    // Infos and warnings are shown on almost every ddev command and
    // cannot be disabled by the user, please use with caution!
    // "notifications": {
    //   "interval": 20,
    //   "infos": [
    //     {
    //       "message": "If you have warnings about omit_containers: [dba] try `grep \"^omit_containers.*dba\" */.ddev/config.yaml` in the directory where you keep your projects"
    //     }
    //   ],
    //   "warnings": []
    // },
    // Ticker messages are shown once in an interval and are rotated
    // once a message was shown.
    "notifications": {
      "interval": 20,
      "infos": [
        {
          "message": "Please upgrade to latest DDEV v1.24 to avoid potential problems with upcoming versions of Docker providers as they support Docker 28. https://github.com/ddev/ddev/releases",
          "versions": "<v1.24.3"
        }
      ],
      "warnings": []
    },
    "ticker": {
      "interval": 20,
      "messages": [
        {
          "message": "You are seeing an overridden and minified list of DDEV tips of the day from Annetech!"
        },
        {
          "message": "Use `ddev branch` to make a git branch with the proper naming convention."
        },
        {
          "message": "'ddev devmode' can quickly switch between development mode and performance (live) mode."
        },
        {
          "message": "'ddev timeslip' will copy a nicely formatted timeslip comment in your clipboard."
        },
        {
          "message": "Visit https://github.com/Annertech/annertech-ddev to see all provided commands offered by the annertech-ddev add-on."
        },
        {
          "message": "'ddev remote-db' will get you a fresh, sanitized DB dump from the production environment."
        },
        {
          "message": "We try to have a decent automated test coverage in all projects. Run tests with 'ddev backstop', 'ddev behat' and 'ddev cypress'!"
        },
        {
          "message": "See 'ddev help drupal-updater' for an automatic updater of composer dependencies with atomic commits for each update!"
        }
      ]
    }
  }
}
